# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA NIM — https://build.nvidia.com/ (Get API Key on any model page)
NVIDIA_API_KEY=

# --- optional ---------------------------------------------------------------

# Ordered model chain, best first, "provider:model" comma separated.
# The backend steps down this list as free-tier allowances run out.
# Providers: groq, nvidia. Slots whose key is missing are skipped.
# Leave unset to use the built-in chain, which is the line below.
# WHITEBOARD_MODELS=groq:llama-3.3-70b-versatile,nvidia:nvidia/nemotron-3-super-120b-a12b,nvidia:meta/llama-3.1-70b-instruct,nvidia:nvidia/nemotron-3-nano-30b-a3b,groq:llama-3.1-8b-instant
#
# NVIDIA ids are exact and case-sensitive. To see what your account can reach:
#   curl.exe -s -H "Authorization: Bearer $env:NVIDIA_API_KEY" https://integrate.api.nvidia.com/v1/models
# A model in that list can still 404 if it is not enabled for your account.

# failover (default) — always start at the top of the chain
# round_robin        — start one slot further along each request, spreading load
# WHITEBOARD_ROUTING=failover

# How much of the reference to send: auto (default) | core | full
# WHITEBOARD_SPEC=auto

# Seconds before a model call is abandoned and the next slot is tried.
# WHITEBOARD_TIMEOUT=60
